<Window x:Class="Biblioteca.Cliente.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biblioteca"
        Height="600"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#252526">

            <StackPanel>

                <TextBlock Text="Biblioteca" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20" HorizontalAlignment="Center"/>

                <Button Content="Categorias" Height="45" Margin="10,5" Click="btnCategorias_Click"/>

                <Button Content="Livros" Height="45" Margin="10,5" Click="btnLivros_Click"/>

                <Button Content="Utilizadores" Height="45" Margin="10,5" Click="btnUtilizadores_Click"/>

                <Button Content="Empréstimos" Height="45" Margin="10,5" IsEnabled="False"/>

                <Button Content="Reservas" Height="45" Margin="10,5" IsEnabled="False"/>

                <Button Content="Penalizações" Height="45" Margin="10,5" IsEnabled="False"/>

            </StackPanel>

        </Border>

        <ContentControl x:Name="conteudoPrincipal" Grid.Column="1"/>

    </Grid>

</Window>