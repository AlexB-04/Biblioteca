<UserControl x:Class="Biblioteca.Cliente.WPF.Views.CreditosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Créditos" FontSize="26" FontWeight="Bold" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="White" Padding="30" CornerRadius="6" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="SISTEMA DE GESTÃO DE BIBLIOTECA" FontSize="24" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Autor: Alexandre Bezverkhyy" FontSize="16" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Curso: CET 108 - TPSI" FontSize="16" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="UC00608 - Programação de Sistemas Distribuídos" FontSize="16" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Projeto baseado na aplicação desenvolvida na UC00607" FontSize="16" TextAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Tecnologias utilizadas" FontSize="18" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="ASP.NET Web API" FontSize="16" TextAlignment="Center"/>
                <TextBlock Text="WPF" FontSize="16" TextAlignment="Center"/>
                <TextBlock Text="SQL Server" FontSize="16" TextAlignment="Center"/>
                <TextBlock Text="LINQ to SQL" FontSize="16" TextAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="Versão: 2.0" FontSize="16" TextAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Data: Agosto 2026" FontSize="16" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>