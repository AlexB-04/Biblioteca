@{
    ViewBag.Title = "Início";
}

<main>
    <section class="row" aria-labelledby="bibliotecaTitle">
        <h1 id="bibliotecaTitle">Biblioteca API</h1>

        <p class="lead">
            Sistema de Gestão de Biblioteca desenvolvido para a UC00608.
        </p>

        <p>
            Esta API permite gerir categorias, livros, utilizadores,
            empréstimos, reservas e penalizações.
        </p>

        <p>
            O cliente WPF comunica com esta API para consultar,
            criar, alterar e eliminar os dados armazenados no SQL Server.
        </p>
    </section>

    <div class="row">
        <section class="col-md-4" aria-labelledby="livrosTitle">
            <h2 id="livrosTitle">Livros e Categorias</h2>

            <p>
                Organização dos livros por categorias e controlo
                dos exemplares disponíveis.
            </p>
        </section>

        <section class="col-md-4" aria-labelledby="emprestimosTitle">
            <h2 id="emprestimosTitle">Empréstimos e Reservas</h2>

            <p>
                Gestão de empréstimos, devoluções,
                reservas e filas de espera.
            </p>
        </section>

        <section class="col-md-4" aria-labelledby="penalizacoesTitle">
            <h2 id="penalizacoesTitle">Penalizações</h2>

            <p>
                Controlo de atrasos, multas,
                pagamentos e bloqueios temporários.
            </p>
        </section>
    </div>
</main>